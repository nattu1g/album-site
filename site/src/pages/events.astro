---
import { getEvents } from '../lib/sheets';
import Auth from '../components/Auth.astro';

const events = await getEvents();
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>学校行事 - 卒業アルバム</title>
</head>
<body>
  <Auth />

  <main>
    <div class="header">
      <a href="/" class="back-button">← トップに戻る</a>
      <h1>学校行事</h1>
    </div>
    
    <div class="event-grid">
      {events.map(event => (
        <div class="event-card">
          <img 
            src={`/images/events/${event.photo_filename}`} 
            alt={event.title}
            loading="lazy"
          />
          <div class="event-info">
            <span class="category">{event.category}</span>
            <h2>{event.title}</h2>
            {event.date && <p class="date">{event.date}</p>}
            {event.comment && <p class="comment">{event.comment}</p>}
            {event.tags.length > 0 && (
              <div class="tags">
                {event.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </main>
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 2rem;
  }

  .back-button {
    display: inline-block;
    color: white;
    text-decoration: none;
    margin-bottom: 1rem;
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .back-button:hover {
    transform: translateX(-5px);
  }

  h1 {
    color: white;
    font-size: 2.5rem;
    text-align: center;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .event-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .event-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .event-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #f0f0f0;
  }

  .event-info {
    padding: 1.5rem;
  }

  .category {
    display: inline-block;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .event-card h2 {
    font-size: 1.5rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .date {
    color: #999;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .comment {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: #f0f0f0;
    color: #666;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .event-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
