---
import { getStudents } from '../lib/sheets';
import Auth from '../components/Auth.astro';

const students = await getStudents();
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ランダム表示 - 卒業アルバム</title>
</head>
<body>
  <Auth />

  <main>
    <div class="header">
      <a href="/" class="back-button">← トップに戻る</a>
      <h1>🎲 ランダム表示</h1>
      <p class="subtitle">ボタンを押してランダムに生徒を表示!</p>
    </div>

    <div class="gacha-container">
      <button id="gacha-button" class="gacha-button">
        <span class="button-text">ガチャを回す!</span>
      </button>

      <div id="result-container" class="result-container hidden">
        <div class="result-card">
          <img id="result-image" src="" alt="" />
          <h2 id="result-name"></h2>
          <p id="result-class" class="class"></p>
          <div id="result-tags" class="tags"></div>
        </div>
      </div>
    </div>
  </main>
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .back-button {
    display: inline-block;
    color: white;
    text-decoration: none;
    margin-bottom: 1rem;
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .back-button:hover {
    transform: translateX(-5px);
  }

  h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.1rem;
  }

  .gacha-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .gacha-button {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
    border: none;
    padding: 2rem 4rem;
    border-radius: 50px;
    font-size: 1.5rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(245, 87, 108, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .gacha-button:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(245, 87, 108, 0.6);
  }

  .gacha-button:active {
    transform: translateY(-2px) scale(1.02);
  }

  .gacha-button.spinning {
    animation: spin 0.5s ease-in-out;
  }

  @keyframes spin {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.1); }
    100% { transform: rotate(360deg) scale(1); }
  }

  .result-container {
    width: 100%;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .result-container.hidden {
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .result-card {
    background: white;
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    text-align: center;
    animation: slideIn 0.5s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-card img {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .result-card h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .class {
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .tag {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }

    h1 {
      font-size: 2rem;
    }

    .gacha-button {
      padding: 1.5rem 3rem;
      font-size: 1.2rem;
    }

    .result-card {
      padding: 2rem;
    }

    .result-card h2 {
      font-size: 1.5rem;
    }
  }
</style>

<script define:vars={{ students }}>
  const gachaButton = document.getElementById('gacha-button');
  const resultContainer = document.getElementById('result-container');
  const resultImage = document.getElementById('result-image');
  const resultName = document.getElementById('result-name');
  const resultClass = document.getElementById('result-class');
  const resultTags = document.getElementById('result-tags');

  gachaButton?.addEventListener('click', () => {
    // ボタンアニメーション
    gachaButton.classList.add('spinning');
    
    setTimeout(() => {
      gachaButton.classList.remove('spinning');
      
      // ランダムに生徒を選択
      const randomStudent = students[Math.floor(Math.random() * students.length)];
      
      // 結果を表示
      resultImage.src = `/images/students/${randomStudent.photo_filename}`;
      resultImage.alt = randomStudent.name;
      resultName.textContent = randomStudent.name;
      resultClass.textContent = randomStudent.class;
      
      // タグを表示
      resultTags.innerHTML = '';
      randomStudent.tags.forEach(tag => {
        const tagElement = document.createElement('span');
        tagElement.className = 'tag';
        tagElement.textContent = tag;
        resultTags.appendChild(tagElement);
      });
      
      // 結果コンテナを表示
      resultContainer.classList.remove('hidden');
    }, 500);
  });
</script>
