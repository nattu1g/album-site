---
import { getStudents } from '../lib/sheets';
import { getStudentImage } from '../lib/images';
import { getImage } from 'astro:assets';
import Auth from '../components/Auth.astro';

const students = await getStudents();

// 画像URLを事前解決
const studentsWithImages = await Promise.all(students.map(async (s) => {
  const imagePromise = getStudentImage(s.photo_filename);
  if (imagePromise) {
    const optimizedImage = await getImage({ src: imagePromise, format: 'webp', width: 400, height: 400 });
    return { ...s, imageSrc: optimizedImage.src };
  }
  return { ...s, imageSrc: null };
}));
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ランダム表示 - 卒業アルバム</title>
</head>
<body>
  <Auth />

  <main>
    <div class="header">
      <a href={import.meta.env.BASE_URL + '/'} class="back-button">← トップに戻る</a>
      <h1>🎲 ランダム表示</h1>
      <p class="subtitle">ボタンを押してランダムに生徒を表示!</p>
    </div>

    <div class="gacha-container">
      <button id="gacha-button" class="gacha-button">
        <span class="button-text">ガチャを回す!</span>
      </button>

      <div id="result-container" class="result-container hidden">
        <a id="result-link" href="#" class="result-link">
          <div class="result-card">
            <img id="result-image" src="" alt="" />
            <h2 id="result-name"></h2>
            <p id="result-class" class="class"></p>
            <div id="result-tags" class="tags"></div>
            <p class="click-hint">クリックで詳細を見る →</p>
          </div>
        </a>
      </div>
    </div>
  </main>
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .back-button {
    display: inline-block;
    color: white;
    text-decoration: none;
    margin-bottom: 1rem;
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .back-button:hover {
    transform: translateX(-5px);
  }

  h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.1rem;
  }

  .gacha-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .gacha-button {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    border: none;
    padding: 1.5rem 4rem;
    border-radius: 50px;
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(245, 87, 108, 0.4);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }

  .gacha-button:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
  }

  .gacha-button:active {
    transform: translateY(2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .result-container {
    width: 100%;
    max-width: 400px;
    perspective: 1000px;
  }

  .result-container.hidden {
    display: none;
  }

  .result-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .result-link:hover {
    transform: scale(1.02);
  }

  .result-card {
    background: white;
    padding: 2rem;
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    text-align: center;
    animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }
  
  .click-hint {
    margin-top: 1rem;
    color: #667eea;
    font-size: 0.9rem;
    font-weight: bold;
    opacity: 0;
    transform: translateY(10px);
    animation: fadeInUp 0.5s ease 0.5s forwards;
  }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-link:hover .click-hint {
    text-decoration: underline;
  }

  @keyframes popIn {
    0% {
      opacity: 0;
      transform: scale(0.5) rotateX(-90deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotateX(0);
    }
  }

  .result-card img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 1.5rem;
    border: 5px solid #f0f2f5;
    background: #f0f0f0;
  }

  .result-card h2 {
    font-size: 1.8rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .class {
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .tag {
    background: #f0f2f5;
    color: #555;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .gacha-button {
      padding: 1rem 3rem;
      font-size: 1.2rem;
    }
  }
</style>

<script define:vars={{ students: studentsWithImages, baseUrl: import.meta.env.BASE_URL }}>
  const gachaButton = document.getElementById('gacha-button');
  const resultContainer = document.getElementById('result-container');
  const resultLink = document.getElementById('result-link');
  const resultImage = document.getElementById('result-image');
  const resultName = document.getElementById('result-name');
  const resultClass = document.getElementById('result-class');
  const resultTags = document.getElementById('result-tags');

  let isAnimating = false;

  gachaButton?.addEventListener('click', () => {
    if (isAnimating) return;
    isAnimating = true;

    // 演出
    resultContainer?.classList.add('hidden');
    gachaButton.style.transform = 'scale(0.95)';
    
    setTimeout(() => {
      gachaButton.style.transform = '';
      
      // ランダムに生徒を選択
      const randomIndex = Math.floor(Math.random() * students.length);
      const student = students[randomIndex];

      // データをセット
      if (resultImage) {
        if (student.imageSrc) {
          resultImage.src = student.imageSrc;
        } else {
          resultImage.src = ''; // またはプレースホルダー
        }
        resultImage.alt = student.name;
      }
      if (resultName) resultName.textContent = student.name;
      if (resultClass) resultClass.textContent = student.class;
      
      // リンク先を設定
      if (resultLink) {
        resultLink.href = `${baseUrl}/students/${student.id}/`;
      }

      if (resultTags) {
        resultTags.innerHTML = student.tags
          .map(tag => `<span class="tag">${tag}</span>`)
          .join('');
      }

      // 結果を表示
      resultContainer?.classList.remove('hidden');
      
      // アニメーション再実行のためにクラスを付け外し
      const card = document.querySelector('.result-card');
      card?.classList.remove('animate');
      void card?.offsetWidth; // リフロー
      card?.classList.add('animate');

      isAnimating = false;
    }, 500);
  });
</script>
