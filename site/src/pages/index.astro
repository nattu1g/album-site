---
// トップページ - メインナビゲーション
import Auth from '../components/Auth.astro';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>卒業アルバム</title>
</head>
<body>
  <!-- パスワード認証 -->
  <Auth />

  <!-- メインコンテンツ -->
  <main id="main-content">
    <div class="container">
      <header>
        <h1>🎓 卒業アルバム</h1>
        <p class="subtitle">思い出の写真を振り返ろう</p>
      </header>

      <nav class="menu-grid">
        <a href={`${import.meta.env.BASE_URL}/students/`} class="menu-card">
          <div class="icon">👥</div>
          <h2>生徒一覧</h2>
          <p>クラスメイトの写真を見る</p>
        </a>

        <a href={`${import.meta.env.BASE_URL}/events/`} class="menu-card">
          <div class="icon">🎉</div>
          <h2>学校行事</h2>
          <p>体育祭・文化祭などの思い出</p>
        </a>

        <a href={`${import.meta.env.BASE_URL}/clubs/`} class="menu-card">
          <div class="icon">⚽</div>
          <h2>部活動</h2>
          <p>部活動の活動記録</p>
        </a>

        <a href={`${import.meta.env.BASE_URL}/teachers/`} class="menu-card">
          <div class="icon">👨‍🏫</div>
          <h2>先生</h2>
          <p>お世話になった先生方</p>
        </a>

        <a href={`${import.meta.env.BASE_URL}/random/`} class="menu-card special">
          <div class="icon">🎲</div>
          <h2>ランダム表示</h2>
          <p>ガチャで誰かを表示!</p>
        </a>
      </nav>

      <!-- YouTubeチャンネルリンク -->
      <div class="youtube-link-container">
        <a href="https://www.youtube.com/@sundayman521" target="_blank" rel="noopener noreferrer" class="youtube-link">
          <div class="youtube-icon">▶️</div>
          <div class="youtube-text">
            <span class="youtube-title">YouTubeチャンネル</span>
            <span class="youtube-subtitle">動画で思い出を振り返る</span>
          </div>
        </a>
      </div>
    </div>
  </main>

  <!-- BGM -->
  <audio id="bgm" loop>
    <source src={`${import.meta.env.BASE_URL}/audio/bgm.mp3`} type="audio/mpeg">
  </audio>

  <script src={`${import.meta.env.BASE_URL}/js/bgm-manager.js`}></script>
  <script>
    // パスワード認証後にBGMを再生
    console.log('BGM script loaded');
    
    const bgm = document.getElementById('bgm') as HTMLAudioElement;
    const mainContent = document.getElementById('main-content');
    
    console.log('BGM element:', bgm);
    console.log('Main content:', mainContent);
    console.log('BGMManager available:', typeof window.BGMManager);
    
    if (bgm && mainContent) {
      if (!window.BGMManager) {
        console.error('BGMManager not loaded!');
      } else {
        const bgmManager = new window.BGMManager();
        console.log('BGMManager instance created');
        
        // メインコンテンツが表示されたらBGMを初期化
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
              const display = window.getComputedStyle(mainContent).display;
              console.log('Main content display changed:', display);
              if (display !== 'none') {
                console.log('Initializing BGM...');
                bgmManager.init(bgm);
                observer.disconnect(); // 一度初期化したら監視を停止
              }
            }
          });
        });
        
        observer.observe(mainContent, { attributes: true });
        
        // 初期状態でメインコンテンツが表示されている場合
        const currentDisplay = window.getComputedStyle(mainContent).display;
        console.log('Initial main content display:', currentDisplay);
        if (currentDisplay !== 'none') {
          console.log('Initializing BGM immediately...');
          bgmManager.init(bgm);
        }
      }
    } else {
      console.error('BGM or main content not found!');
    }
  </script>
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  header {
    text-align: center;
    margin-bottom: 3rem;
  }

  header h1 {
    color: white;
    font-size: 3rem;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.2rem;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .menu-card {
    background: white;
    border-radius: 20px;
    padding: 2.5rem;
    text-align: center;
    text-decoration: none;
    color: #333;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .menu-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .menu-card.special {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
  }

  .icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .menu-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .menu-card p {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .menu-card.special p {
    opacity: 0.95;
  }

  /* YouTubeリンク */
  .youtube-link-container {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }

  .youtube-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg, #ff0000 0%, #cc0000 100%);
    color: white;
    padding: 1.5rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(255, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .youtube-link:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(255, 0, 0, 0.4);
  }

  .youtube-icon {
    font-size: 2rem;
  }

  .youtube-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .youtube-title {
    font-size: 1.2rem;
    font-weight: bold;
  }

  .youtube-subtitle {
    font-size: 0.85rem;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }

    header h1 {
      font-size: 2rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .menu-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .menu-card {
      padding: 2rem;
    }

    .icon {
      font-size: 3rem;
    }
  }
</style>
