---
import { getTeachers, getTeacherById } from '../../lib/sheets';
import { getTeacherImage } from '../../lib/images';
import { Image } from 'astro:assets';
import Auth from '../../components/Auth.astro';
import BGM from '../../components/BGM.astro';

export async function getStaticPaths() {
  const teachers = await getTeachers();
  return teachers.map(teacher => ({
    params: { id: teacher.id },
    props: { teacher },
  }));
}

const { teacher } = Astro.props;
const imagePromise = getTeacherImage(teacher.photo_filename);
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{teacher.name} - 卒業アルバム</title>
</head>
<body>
  <!-- パスワード認証 -->
  <Auth />

  <main>
    <div class="header">
      <a href={`${import.meta.env.BASE_URL}/teachers/`} class="back-button">← 先生一覧に戻る</a>
    </div>

    <div class="detail-container">
      <div class="image-section">
        {imagePromise ? (
          <Image 
            src={imagePromise} 
            alt={teacher.name}
            class="main-image"
            id="main-image"
            width={400}
            height={400}
            format="webp"
          />
        ) : (
          <div class="no-image">No Image</div>
        )}
        <p class="hint">※画像をクリックすると拡大します</p>
      </div>

      <div class="info-section">
        <div class="info-card">
          <h1>{teacher.name}</h1>
          <p class="category">{teacher.subject}</p>
          
          <div class="divider"></div>
          
          <div class="comment-box">
            <h3>先生からのメッセージ</h3>
            <p>{teacher.comment || 'コメントはありません'}</p>
          </div>

          {teacher.tags.length > 0 && (
            <div class="tags-section">
              <h3>タグ</h3>
              <div class="tags">
                {teacher.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>

  <!-- 画像拡大モーダル -->
  <div id="image-modal" class="modal hidden">
    <span class="close">&times;</span>
    <img class="modal-content" id="modal-img">
    <div id="caption"></div>
  </div>

  <BGM />
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  main {
    max-width: 1000px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 2rem;
  }

  .back-button {
    display: inline-block;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    backdrop-filter: blur(5px);
    transition: all 0.2s ease;
  }

  .back-button:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateX(-5px);
  }

  .detail-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .image-section {
    position: sticky;
    top: 2rem;
  }

  .main-image {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    cursor: zoom-in;
    transition: transform 0.3s ease;
    background: white;
  }

  .main-image:hover {
    transform: scale(1.02);
  }

  .hint {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.8rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .info-card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  h1 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .category {
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .divider {
    height: 1px;
    background: #eee;
    margin: 1.5rem 0;
  }

  .comment-box h3, .tags-section h3 {
    font-size: 1rem;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .comment-box p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #444;
    white-space: pre-wrap;
  }

  .tags-section {
    margin-top: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: #f0f2f5;
    color: #555;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
  }

  /* Modal Styles */
  .modal {
    position: fixed;
    z-index: 1000;
    padding-top: 50px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.9);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .modal.show {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    margin: auto;
    display: block;
    max-width: 90%;
    max-height: 85vh;
    border-radius: 8px;
    object-fit: contain;
  }

  .close {
    position: absolute;
    top: 20px;
    right: 35px;
    color: #f1f1f1;
    font-size: 40px;
    font-weight: bold;
    transition: 0.3s;
    cursor: pointer;
  }

  .close:hover,
  .close:focus {
    color: #bbb;
    text-decoration: none;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }

    .detail-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .image-section {
      position: static;
    }

    .info-card {
      padding: 1.5rem;
    }

    h1 {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // モーダル機能
  const modal = document.getElementById('image-modal');
  const img = document.getElementById('main-image') as HTMLImageElement;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const closeBtn = document.getElementsByClassName('close')[0] as HTMLElement;

  if (img && modal && modalImg) {
    img.onclick = function() {
      modal.classList.add('show');
      modalImg.src = this.src;
    }
  }

  if (closeBtn && modal) {
    closeBtn.onclick = function() {
      modal.classList.remove('show');
    }

    modal.onclick = function(e) {
      if (e.target === modal) {
        modal.classList.remove('show');
      }
    }
  }

  // ESCキーで閉じる
  document.addEventListener('keydown', function(event) {
    if (event.key === "Escape" && modal?.classList.contains('show')) {
      modal.classList.remove('show');
    }
  });
</script>
