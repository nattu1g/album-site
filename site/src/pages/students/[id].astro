---
import { getStudents, getStudentById } from '../../lib/sheets';
import Auth from '../../components/Auth.astro';

// 動的ルーティング: すべての生徒IDのパスを生成
export async function getStaticPaths() {
  const students = await getStudents();
  
  return students.map(student => ({
    params: { id: student.id },
    props: { student },
  }));
}

const { student } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{student.name} - 卒業アルバム</title>
</head>
<body>
  <Auth />

  <main>
    <div class="header">
      <a href={`${import.meta.env.BASE_URL}students/`} class="back-button">← 生徒一覧に戻る</a>
    </div>

    <div class="detail-container">
      <div class="image-section">
        <img 
          src={`${import.meta.env.BASE_URL}images/students/${student.photo_filename}`} 
          alt={student.name}
          class="main-image"
          id="main-image"
        />
      </div>

      <div class="info-section">
        <h1>{student.name}</h1>
        
        <div class="info-grid">
          <div class="info-item">
            <span class="label">クラス</span>
            <span class="value">{student.class}</span>
          </div>

          {student.date && (
            <div class="info-item">
              <span class="label">撮影時期</span>
              <span class="value">{student.date}</span>
            </div>
          )}

          {student.tags.length > 0 && (
            <div class="info-item full-width">
              <span class="label">タグ</span>
              <div class="tags">
                {student.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}

          {student.comment && (
            <div class="info-item full-width">
              <span class="label">コメント</span>
              <p class="comment">{student.comment}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>

  <!-- 画像ズームモーダル -->
  <div id="zoom-modal" class="zoom-modal">
    <span class="close-button">&times;</span>
    <img id="zoomed-image" class="zoomed-image" src="" alt="">
  </div>
</body>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 2rem;
  }

  main {
    max-width: 1000px;
    margin: 0 auto;
  }

  .header {
    margin-bottom: 2rem;
  }

  .back-button {
    display: inline-block;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .back-button:hover {
    transform: translateX(-5px);
  }

  .detail-container {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .image-section {
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }

  .main-image {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .main-image:hover {
    transform: scale(1.05);
  }

  /* ズームモーダル */
  .zoom-modal {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    animation: fadeIn 0.3s ease;
  }

  .zoom-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .zoomed-image {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: 8px;
    animation: zoomIn 0.3s ease;
  }

  @keyframes zoomIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .close-button {
    position: absolute;
    top: 2rem;
    right: 2rem;
    color: white;
    font-size: 3rem;
    font-weight: 300;
    cursor: pointer;
    transition: transform 0.2s ease;
    z-index: 10001;
  }

  .close-button:hover {
    transform: scale(1.2);
  }

  .info-section {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .info-grid {
    display: grid;
    gap: 1.5rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .info-item.full-width {
    grid-column: 1 / -1;
  }

  .label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .value {
    font-size: 1.25rem;
    color: #333;
    font-weight: 500;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .comment {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.6;
    padding: 1rem;
    background: #f9f9f9;
    border-radius: 12px;
    border-left: 4px solid #667eea;
  }

  @media (max-width: 768px) {
    body {
      padding: 1rem;
    }

    .detail-container {
      grid-template-columns: 1fr;
    }

    .image-section {
      padding: 2rem;
    }

    .main-image {
      max-width: 100%;
    }

    .info-section {
      padding: 2rem;
    }

    h1 {
      font-size: 2rem;
    }

    .value {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // 画像ズーム機能
  const mainImage = document.getElementById('main-image');
  const zoomModal = document.getElementById('zoom-modal');
  const zoomedImage = document.getElementById('zoomed-image');
  const closeButton = document.querySelector('.close-button');

  // 画像クリックでモーダルを開く
  mainImage?.addEventListener('click', () => {
    zoomModal?.classList.add('active');
    if (zoomedImage && mainImage) {
      zoomedImage.src = mainImage.src;
      zoomedImage.alt = mainImage.alt;
    }
  });

  // 閉じるボタンでモーダルを閉じる
  closeButton?.addEventListener('click', () => {
    zoomModal?.classList.remove('active');
  });

  // モーダル背景クリックで閉じる
  zoomModal?.addEventListener('click', (e) => {
    if (e.target === zoomModal) {
      zoomModal.classList.remove('active');
    }
  });

  // ESCキーで閉じる
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && zoomModal?.classList.contains('active')) {
      zoomModal.classList.remove('active');
    }
  });
</script>
