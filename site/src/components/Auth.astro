---
// パスワード認証コンポーネント
---

<div id="auth-overlay" class="auth-overlay">
  <div class="auth-container">
    <h1>🎓 卒業アルバム</h1>
    <p class="subtitle">パスワードを入力してください</p>
    
    <form id="auth-form" class="auth-form">
      <input 
        type="password" 
        id="password-input" 
        placeholder="パスワード" 
        autocomplete="off"
        required
      />
      <button type="submit">ログイン</button>
    </form>
    
    <p id="error-message" class="error-message"></p>
  </div>
</div>

<style>
  .auth-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .auth-overlay.hidden {
    display: none;
  }

  .auth-container {
    background: white;
    padding: 3rem;
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    max-width: 400px;
    width: 90%;
    text-align: center;
  }

  .auth-container h1 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #666;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .auth-form input {
    padding: 1rem;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  .auth-form input:focus {
    outline: none;
    border-color: #667eea;
  }

  .auth-form button {
    padding: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .auth-form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }

  .auth-form button:active {
    transform: translateY(0);
  }

  .error-message {
    color: #e74c3c;
    font-size: 0.9rem;
    margin-top: 1rem;
    min-height: 1.5rem;
  }

  @media (max-width: 768px) {
    .auth-container {
      padding: 2rem;
    }

    .auth-container h1 {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // パスワード設定（本番環境では環境変数などで管理することを推奨）
  const CORRECT_PASSWORD = '898943';

  // セッションストレージのキー
  const AUTH_KEY = 'album_authenticated';

  // ページ読み込み時に認証状態をチェック
  function checkAuth() {
    const isAuthenticated = sessionStorage.getItem(AUTH_KEY) === 'true';
    const overlay = document.getElementById('auth-overlay');
    
    if (isAuthenticated) {
      overlay?.classList.add('hidden');
    } else {
      overlay?.classList.remove('hidden');
    }
    
    return isAuthenticated;
  }

  // 認証処理
  function authenticate(password: string): boolean {
    return password === CORRECT_PASSWORD;
  }

  // フォーム送信処理
  const form = document.getElementById('auth-form') as HTMLFormElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const password = passwordInput.value;
    
    if (authenticate(password)) {
      // 認証成功
      sessionStorage.setItem(AUTH_KEY, 'true');
      const overlay = document.getElementById('auth-overlay');
      overlay?.classList.add('hidden');
      errorMessage.textContent = '';
    } else {
      // 認証失敗
      errorMessage.textContent = 'パスワードが正しくありません';
      passwordInput.value = '';
      passwordInput.focus();
    }
  });

  // 初期チェック
  checkAuth();
</script>
