---
// BGMコンポーネント - 全ページで共通して使用
---

<!-- BGM -->
<audio id="bgm" loop>
  <source src={`${import.meta.env.BASE_URL}/audio/bgm.mp3`} type="audio/mpeg">
</audio>

<script src={`${import.meta.env.BASE_URL}/js/bgm-manager.js`}></script>
<script>
  // BGMを初期化
  const bgm = document.getElementById('bgm') as HTMLAudioElement;
  
  if (bgm && window.BGMManager) {
    const bgmManager = new window.BGMManager();
    
    // ページ読み込み後すぐにBGMを初期化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        bgmManager.init(bgm);
      });
    } else {
      bgmManager.init(bgm);
    }
  }
</script>
